#!/usr/bin/env bash
# Sets up the claude-agent user, which runs Claude Code isolated from your own
# credentials: it can't read your home directory (AWS SSO cache, SSH keys,
# ~/.netrc, browser profiles) or reach your own Postgres and Redis, and has its
# own clones, database server, read-only AWS identity and Playwright browsers.
#
# Run it as yourself (it uses sudo where needed); it's safe to run again.
# The checkouts the agent gets clones of are listed, one per line, in
# ~/.config/claude-agent/repos. That file stays local because this repo is
# public.
set -euo pipefail

DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DOTFILES="$(dirname "$DIR")"
AGENT=claude-agent
AGENT_HOME="/home/$AGENT"
REPOS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/claude-agent/repos"
AGENT_DB_PORT=5436
AGENT_REDIS_PORT=6393
NODE_VERSION=24
NVM_VERSION=v0.40.3
PLAYWRIGHT_MCP=@playwright/mcp@0.0.83
PLAYWRIGHT=playwright@1.64.0-alpha-1790635538000
READ_ONLY_ROLE=HerokuLogsReadOnly

step() { printf '\n==> %s\n' "$*"; }

# Runs a bash snippet as the agent in a login shell, so rbenv and nvm load.
as_agent() {
  sudo -u "$AGENT" -H -- bash -lc "$1"
}

# install_as_agent <source, or - for stdin> <destination> [mode]
install_as_agent() {
  local source="$1"
  [[ "$source" == - ]] && source=/dev/stdin
  sudo install -D -o "$AGENT" -g "$AGENT" -m "${3:-644}" "$source" "$2"
}

# The directory name Claude Code keeps a project's sessions and memory under.
claude_project_dir() {
  sed 's/[^a-zA-Z0-9]/-/g' <<< "$1"
}

read_repos() {
  if [[ ! -s "$REPOS_FILE" ]]; then
    mkdir -p "$(dirname "$REPOS_FILE")"
    printf '# Checkouts the claude-agent user gets clones of, one path per line.\n# ~/coding/rails/example\n' > "$REPOS_FILE"
    echo "List your checkouts in $REPOS_FILE, then run this again." >&2
    exit 1
  fi
  mapfile -t REPOS < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e "s#^~#$HOME#" "$REPOS_FILE")
}

create_user() {
  step "User $AGENT"
  id "$AGENT" > /dev/null 2>&1 || sudo useradd --create-home --shell /bin/bash "$AGENT"
  sudo chmod 750 "$AGENT_HOME"
  chmod 750 "$HOME"
  # You can read the agent's clones (git fetch agent); it can't read yours.
  id -nG "$USER" | tr ' ' '\n' | grep -qx "$AGENT" || sudo usermod -aG "$AGENT" "$USER"
  if id -nG "$AGENT" | tr ' ' '\n' | grep -qxE 'sudo|docker|adm'; then
    echo "$AGENT is in a privileged group: $(id -nG "$AGENT")" >&2
    exit 1
  fi

  echo "$USER ALL=($AGENT) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/claude-agent > /dev/null
  sudo chmod 440 /etc/sudoers.d/claude-agent
  sudo visudo -cqf /etc/sudoers.d/claude-agent
}

start_services() {
  step "Postgres and Redis on ports $AGENT_DB_PORT and $AGENT_REDIS_PORT"
  docker compose -p claude-agent -f "$DIR/compose.yml" up -d --wait
}

block_host_services() {
  local repo ports
  step "Blocking the agent from your own Postgres and Redis"
  ports="$(for repo in "${REPOS[@]}"; do
    sed -n -E 's/^(DB_PORT|REDIS_PORT)=([0-9]+).*/\2/p' "$repo"/.env.local "$repo"/.env.test.local 2>/dev/null
  done | sort -un | paste -sd, -)"
  if [[ -z "$ports" ]]; then
    echo "No DB_PORT or REDIS_PORT found in the checkouts' .env.local files; nothing to block."
    return
  fi
  echo "Ports: $ports"

  # Priority -300 runs before Docker's NAT can rewrite the destination.
  sudo tee /etc/claude-agent-firewall.nft > /dev/null <<EOF
table inet claude_agent
delete table inet claude_agent
table inet claude_agent {
  chain output {
    type filter hook output priority -300; policy accept;
    meta skuid "$AGENT" ip daddr 127.0.0.0/8 tcp dport { $ports } reject with tcp reset
    meta skuid "$AGENT" ip6 daddr ::1 tcp dport { $ports } reject with tcp reset
  }
}
EOF
  sudo tee /etc/systemd/system/claude-agent-firewall.service > /dev/null <<'EOF'
[Unit]
Description=Keep the claude-agent user away from the host's own database ports
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/claude-agent-firewall.nft

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  sudo systemctl enable --now claude-agent-firewall.service
  sudo systemctl restart claude-agent-firewall.service

  for port in ${ports//,/ } $AGENT_DB_PORT; do
    if sudo -u "$AGENT" -- timeout 2 bash -c "</dev/tcp/127.0.0.1/$port" 2> /dev/null; then
      [[ "$port" == "$AGENT_DB_PORT" ]] || { echo "The agent can still reach port $port." >&2; exit 1; }
    elif [[ "$port" == "$AGENT_DB_PORT" ]]; then
      echo "The agent can't reach its own Postgres on port $port." >&2
      exit 1
    fi
  done
}

install_toolchain() {
  local ruby_versions
  step "Toolchain: rbenv, Node $NODE_VERSION, Claude Code, Playwright"
  ruby_versions="$(cat "${REPOS[@]/%//.ruby-version}" 2>/dev/null | sort -u | tr '\n' ' ')"

  sudo -u "$AGENT" -H -- bash -c "
    set -e
    [ -d ~/.rbenv ] || git clone -q https://github.com/rbenv/rbenv.git ~/.rbenv
    [ -d ~/.rbenv/plugins/ruby-build ] || git clone -q https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build
    git -C ~/.rbenv/plugins/ruby-build pull -q
    [ -d ~/.nvm ] || git clone -q --branch $NVM_VERSION --depth 1 https://github.com/nvm-sh/nvm.git ~/.nvm"

  install_as_agent - "$AGENT_HOME/.agent-profile" <<EOF
export PATH="\$HOME/.local/bin:\$HOME/.rbenv/bin:\$PATH"
eval "\$(rbenv init - bash)"
export NVM_DIR="\$HOME/.nvm"
. "\$NVM_DIR/nvm.sh"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
export DEV_MODE=local
EOF
  as_agent 'grep -q agent-profile ~/.profile || echo ". ~/.agent-profile" >> ~/.profile
            grep -q agent-profile ~/.bashrc || echo ". ~/.agent-profile" >> ~/.bashrc'

  as_agent "set -e
    for version in $ruby_versions; do rbenv install -s \"\$version\"; done
    nvm install $NODE_VERSION > /dev/null
    nvm alias default $NODE_VERSION > /dev/null
    corepack enable
    command -v claude > /dev/null || curl -fsSL https://claude.ai/install.sh | bash
    npx -y $PLAYWRIGHT install firefox"
}

configure_git_and_github() {
  step "Git identity and GitHub access"
  as_agent "git config --global user.name $(printf '%q' "$(git config --global user.name)")
            git config --global user.email $(printf '%q' "$(git config --global user.email)")"
  if ! as_agent 'gh auth status' > /dev/null 2>&1; then
    gh auth token | sudo -u "$AGENT" -H -- gh auth login --with-token
  fi
  as_agent 'gh auth setup-git'
}

clone_repos() {
  local repo target url name
  for repo in "${REPOS[@]}"; do
    target="$AGENT_HOME/${repo#"$HOME"/}"
    step "Clone $target"

    if ! sudo test -d "$target/.git"; then
      # The agent has no SSH key; gh's credential helper covers HTTPS.
      url="$(git -C "$repo" remote get-url origin | sed -E 's#^git@github\.com:#https://github.com/#')"
      as_agent "git clone -q $(printf '%q' "$url") $(printf '%q' "$target")"
    fi

    # The git-ignored env files, pointed at the agent's Postgres and Redis.
    for file in "$repo"/.env*; do
      name="$(basename "$file")"
      [[ "$name" == .env.worktree ]] && continue
      git -C "$repo" ls-files --error-unmatch "$name" > /dev/null 2>&1 && continue
      sed -e "s/^DB_PORT=.*/DB_PORT=$AGENT_DB_PORT/" -e "s/^REDIS_PORT=.*/REDIS_PORT=$AGENT_REDIS_PORT/" "$file" |
        install_as_agent - "$target/$name" 600
    done
    if [[ -e "$repo/config/credentials/development.key" ]]; then
      install_as_agent "$repo/config/credentials/development.key" "$target/config/credentials/development.key" 600
    fi
    # Your own checkouts' bin/dev use 3000.
    echo "port: 4000" | install_as_agent - "$target/.foreman"

    # A first run (or one that failed halfway) installs and seeds the clone.
    if ! as_agent "cd $(printf '%q' "$target") && bin/run --disable-spring rails runner 'exit ActiveRecord::Base.connection.table_exists?(:schema_migrations)' > /dev/null 2>&1"; then
      as_agent "set -e; cd $(printf '%q' "$target")
        bundle install --quiet
        bin/run yarn install --immutable
        bin/run --disable-spring rails db:create db:preview:restore db:migrate db:test:prepare javascript:build dartsass:build"
    fi

    git -C "$repo" remote get-url agent > /dev/null 2>&1 || git -C "$repo" remote add agent "$target"
  done
  git config --global --get-all safe.directory | grep -qx "$AGENT_HOME/*" ||
    git config --global --add safe.directory "$AGENT_HOME/*"
}

configure_claude() {
  local repo source target
  step "Claude Code settings, hooks, Playwright MCP and memory"
  install_as_agent "$DOTFILES/claude/hooks/worktree.sh" "$AGENT_HOME/.claude/hooks/worktree.sh" 755
  install_as_agent "$DOTFILES/claude/statusline-command.sh" "$AGENT_HOME/.claude/statusline-command.sh"

  # Your settings plus the hooks, merged over the agent's own.
  jq -s '.[0] * .[1]' "$HOME/.claude/settings.json" "$DOTFILES/claude/settings.json" |
    sudo -u "$AGENT" -H -- bash -c '
      settings=~/.claude/settings.json
      [ -e "$settings" ] || echo "{}" > "$settings"
      jq -s ".[0] * .[1]" "$settings" - > "$settings.tmp"
      mv "$settings.tmp" "$settings"'

  as_agent "claude mcp get playwright-chrome > /dev/null 2>&1 ||
              claude mcp add --scope user playwright-chrome -- npx -y $PLAYWRIGHT_MCP --browser chrome --headless --isolated
            claude mcp get playwright-firefox > /dev/null 2>&1 ||
              claude mcp add --scope user playwright-firefox -- npx -y $PLAYWRIGHT_MCP --browser firefox --headless --isolated"

  # Copy each repo's project memory once; after that the agent's copy is its own.
  for repo in "${REPOS[@]}"; do
    source="$HOME/.claude/projects/$(claude_project_dir "$repo")/memory"
    target="$AGENT_HOME/.claude/projects/$(claude_project_dir "$AGENT_HOME/${repo#"$HOME"/}")/memory"
    if [[ -d "$source" ]] && ! sudo test -d "$target"; then
      sudo mkdir -p "$target"
      sudo cp -r "$source/." "$target/"
      sudo chown -R "$AGENT:$AGENT" "$AGENT_HOME/.claude/projects"
    fi
  done
}

configure_aws() {
  step "AWS profiles with the $READ_ONLY_ROLE role only"
  [[ -e "$HOME/.aws/config" ]] || { echo "No ~/.aws/config; skipping."; return; }

  # Keep the SSO session and the read-only profiles, renaming the session so
  # the agent signs in as its own identity.
  awk -v role="$READ_ONLY_ROLE" '
    /^\[/ { flush(); block = $0 "\n"; keep = ($0 ~ /^\[sso-session /); next }
    { block = block $0 "\n"; if ($1 == "sso_role_name" && $3 == role) keep = 1 }
    function flush() { if (keep) printf "%s", block; block = ""; keep = 0 }
    END { flush() }
  ' "$HOME/.aws/config" |
    sed -E -e 's/^\[sso-session [^]]+\]/[sso-session agent]/' -e 's/^([[:space:]]*sso_session *= *).*/\1agent/' |
    install_as_agent - "$AGENT_HOME/.aws/config" 600
  sudo grep -c '^\[profile ' "$AGENT_HOME/.aws/config" | xargs echo "Profiles:"
}

print_manual_steps() {
  cat <<EOF

==> Done. Manual steps (once per machine, or when a token expires):

1. In IAM Identity Center, create a user for the agent and assign it only
   $READ_ONLY_ROLE in the accounts of the profiles above.
2. Sign the agent in to AWS (open the printed URL in a private window and
   log in as the agent identity):
     sudo -iu $AGENT aws sso login --sso-session agent --use-device-code
3. Log out and back in, so your membership in the $AGENT group applies.
4. Start Claude as the agent from one of your checkouts and run /login:
     claude-agent
EOF
}

read_repos
create_user
start_services
block_host_services
install_toolchain
configure_git_and_github
clone_repos
configure_claude
configure_aws
print_manual_steps
